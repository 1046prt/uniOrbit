---
import Base from "../../layouts/Base.astro";
---
<Base title="Electrical Engineering" scripts={[]}>
  <section class="page-hero" slot="hero">
    <div class="container">
      <span class="eyebrow">Course</span>
      <h1>Electrical Engineering</h1>
      <p>Powering the world with innovative electrical systems and smart grid technology</p>
      <div class="hero-actions">
        <a href="/course-registration" class="btn btn-primary btn-lg"><i class="fas fa-edit" aria-hidden="true"></i> Register Now</a>
        <a href="/subjects/electrical" class="btn btn-outline btn-lg"><i class="fas fa-book" aria-hidden="true"></i> View Subjects</a>
      </div>
    </div>
  </section>
  <main class="page-main" id="main">
    <div class="container">
      <section class="course-overview"><div class="card"><h2 class="section-title">Course Overview</h2>
        <div class="overview-grid">
          <div class="overview-item"><i class="fas fa-clock" aria-hidden="true"></i><h3>Duration</h3><p>4 Years (8 Semesters)</p></div>
          <div class="overview-item"><i class="fas fa-graduation-cap" aria-hidden="true"></i><h3>Degree</h3><p>Bachelor of Technology (B.Tech)</p></div>
          <div class="overview-item"><i class="fas fa-users" aria-hidden="true"></i><h3>Intake</h3><p>90 Students per year</p></div>
          <div class="overview-item"><i class="fas fa-star" aria-hidden="true"></i><h3>NAAC Rating</h3><p>A++ Grade</p></div>
        </div></div></section>

      <section class="program-highlights"><div class="card"><h2 class="section-title">Program Highlights</h2>
        <div class="highlights-grid">
          <div class="highlight-item"><div class="highlight-icon"><i class="fas fa-bolt" aria-hidden="true"></i></div><h3>Power Systems Labs</h3><p>High-voltage lab, relay testing, power quality analyzers, smart grid simulator</p></div>
          <div class="highlight-item"><div class="highlight-icon"><i class="fas fa-handshake" aria-hidden="true"></i></div><h3>Industry Partnerships</h3><p>Collaborations with power utilities, renewable energy firms, automation companies</p></div>
          <div class="highlight-item"><div class="highlight-icon"><i class="fas fa-flask" aria-hidden="true"></i></div><h3>Research Focus</h3><p>Smart grids, HVDC, FACTS, EV integration, power electronics, AI in power systems</p></div>
          <div class="highlight-item"><div class="highlight-icon"><i class="fas fa-globe" aria-hidden="true"></i></div><h3>Global Exposure</h3><p>IEEE student chapter, international conferences, exchange programs, hackathons</p></div>
        </div></div></section>

      <section class="curriculum"><div class="card"><h2 class="section-title">Curriculum Structure</h2>
        <div class="semester-grid">
          <div class="semester"><h3>Semester 1 & 2</h3><ul><li>Engineering Mathematics I & II</li><li>Basic Electrical & Electronics</li><li>Electrical Machines I & II</li><li>Programming & Data Structures</li><li>Signals & Systems</li></ul></div>
          <div class="semester"><h3>Semester 3 & 4</h3><ul><li>Analog & Digital Electronics</li><li>Network Theory & Control Systems</li><li>Microprocessors & Microcontrollers</li><li>Power Systems I</li><li>Electromagnetic Fields</li></ul></div>
          <div class="semester"><h3>Semester 5 & 6</h3><ul><li>Power Systems II & Power Electronics</li><li>Control Systems II & DSP</li><li>Renewable Energy & Electric Drives</li><li>Power System Protection</li><li>Embedded Systems & IoT</li></ul></div>
          <div class="semester"><h3>Semester 7 & 8</h3><ul><li>Capstone Project I & II</li><li>Professional Electives (4)</li><li>Industry Internship</li><li>Seminar & Technical Writing</li><li>Comprehensive Viva</li></ul></div>
        </div></div></section>

      <section class="career-prospects"><div class="card"><h2 class="section-title">Career Prospects</h2>
        <div class="career-grid">
          <div class="career-item"><h3>Power Systems Engineer</h3><p>Grid planning, operation, protection, stability, smart grids</p><div class="salary-range">₹6-18 LPA</div></div>
          <div class="career-item"><h3>Power Electronics Engineer</h3><p>Converters, inverters, drives, EV charging, renewable integration</p><div class="salary-range">₹7-20 LPA</div></div>
          <div class="career-item"><h3>Control Systems Engineer</h3><p>Process control, automation, SCADA, robotics, optimization</p><div class="salary-range">₹6-16 LPA</div></div>
          <div class="career-item"><h3>Renewable Energy Engineer</h3><p>Solar/wind farm design, grid integration, storage, policy</p><div class="salary-range">₹6-18 LPA</div></div>
        </div></div></section>

      <section class="placement-stats"><div class="card"><h2 class="section-title">Placement Statistics (2024)</h2>
        <div class="stats-grid">
          <div class="stat-item"><div class="stat-number">94%</div><div class="stat-label">Placement Rate</div></div>
          <div class="stat-item"><div class="stat-number">₹9.5 LPA</div><div class="stat-label">Average Package</div></div>
          <div class="stat-item"><div class="stat-number">₹28 LPA</div><div class="stat-label">Highest Package</div></div>
          <div class="stat-item"><div class="stat-number">95+</div><div class="stat-label">Companies Visited</div></div>
        </div></div></section>

      <section class="cta-section"><div class="card"><h2>Ready to Electrify the Future?</h2><p>Join our Electrical Engineering program and power the transition to sustainable energy.</p><div class="cta-buttons"><a href="/course-registration" class="btn btn-primary btn-lg"><i class="fas fa-edit" aria-hidden="true"></i> Apply Now</a><a href="/contact" class="btn btn-outline btn-lg"><i class="fas fa-phone" aria-hidden="true"></i> Contact Admissions</a></div></div></section>
    </div></main>
</Base>