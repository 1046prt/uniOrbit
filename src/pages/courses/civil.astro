---
import Base from "../../layouts/Base.astro";
---
<Base title="Civil Engineering" scripts={[]}>
  <section class="page-hero" slot="hero">
    <div class="container">
      <span class="eyebrow">Course</span>
      <h1>Civil Engineering</h1>
      <p>Building sustainable infrastructure for tomorrow's world</p>
      <div class="hero-actions">
        <a href="/course-registration" class="btn btn-primary btn-lg"><i class="fas fa-edit" aria-hidden="true"></i> Register Now</a>
        <a href="/subjects/civil" class="btn btn-outline btn-lg"><i class="fas fa-book" aria-hidden="true"></i> View Subjects</a>
      </div>
    </div>
  </section>
  <main class="page-main" id="main">
    <div class="container">
      <section class="course-overview"><div class="card"><h2 class="section-title">Course Overview</h2>
        <div class="overview-grid">
          <div class="overview-item"><i class="fas fa-clock" aria-hidden="true"></i><h3>Duration</h3><p>4 Years (8 Semesters)</p></div>
          <div class="overview-item"><i class="fas fa-graduation-cap" aria-hidden="true"></i><h3>Degree</h3><p>Bachelor of Technology (B.Tech)</p></div>
          <div class="overview-item"><i class="fas fa-users" aria-hidden="true"></i><h3>Intake</h3><p>120 Students per year</p></div>
          <div class="overview-item"><i class="fas fa-star" aria-hidden="true"></i><h3>NAAC Rating</h3><p>A++ Grade</p></div>
        </div></div></section>

      <section class="program-highlights"><div class="card"><h2 class="section-title">Program Highlights</h2>
        <div class="highlights-grid">
          <div class="highlight-item"><div class="highlight-icon"><i class="fas fa-building" aria-hidden="true"></i></div><h3>Modern Infrastructure Labs</h3><p>State-of-the-art structural, geotechnical, and transportation testing facilities</p></div>
          <div class="highlight-item"><div class="highlight-icon"><i class="fas fa-handshake" aria-hidden="true"></i></div><h3>Industry Partnerships</h3><p>Collaborations with top construction firms, government agencies, and consultancies</p></div>
          <div class="highlight-item"><div class="highlight-icon"><i class="fas fa-flask" aria-hidden="true"></i></div><h3>Research Focus</h3><p>Sustainable materials, earthquake engineering, smart cities, climate resilience</p></div>
          <div class="highlight-item"><div class="highlight-icon"><i class="fas fa-globe" aria-hidden="true"></i></div><h3>Field Exposure</h3><p>Site visits, survey camps, industrial training, live project experience</p></div>
        </div></div></section>

      <section class="curriculum"><div class="card"><h2 class="section-title">Curriculum Structure</h2>
        <div class="semester-grid">
          <div class="semester"><h3>Semester 1 & 2</h3><ul><li>Engineering Mathematics I & II</li><li>Engineering Mechanics & Physics</li><li>Engineering Graphics & Surveying I</li><li>Environmental Science</li><li>Building Materials</li></ul></div>
          <div class="semester"><h3>Semester 3 & 4</h3><ul><li>Strength of Materials & Fluid Mechanics</li><li>Surveying II & Concrete Technology</li><li>Structural Analysis I & Geotech I</li><li>Transportation I & Hydraulics</li><li>Construction Management</li></ul></div>
          <div class="semester"><h3>Semester 5 & 6</h3><ul><li>Structural Analysis II & Geotech II</li><li>Transportation II & Steel/Concrete Design</li><li>Water Resources & Environmental Engg</li><li>Construction Technology & Management</li><li>Advanced Structural Design</li></ul></div>
          <div class="semester"><h3>Semester 7 & 8</h3><ul><li>Capstone Project I & II</li><li>Professional Electives (4)</li><li>Industry Internship</li><li>Seminar & Technical Writing</li><li>Comprehensive Viva</li></ul></div>
        </div></div></section>

      <section class="career-prospects"><div class="card"><h2 class="section-title">Career Prospects</h2>
        <div class="career-grid">
          <div class="career-item"><h3>Structural Engineer</h3><p>Buildings, bridges, towers, industrial structures design</p><div class="salary-range">₹5-14 LPA</div></div>
          <div class="career-item"><h3>Geotechnical Engineer</h3><p>Foundations, tunnels, slopes, ground improvement</p><div class="salary-range">₹5-15 LPA</div></div>
          <div class="career-item"><h3>Construction Manager</h3><p>Project planning, execution, cost control, quality</p><div class="salary-range">₹6-18 LPA</div></div>
          <div class="career-item"><h3>Transportation Engineer</h3><p>Highways, railways, airports, traffic systems</p><div class="salary-range">₹5-16 LPA</div></div>
        </div></div></section>

      <section class="placement-stats"><div class="card"><h2 class="section-title">Placement Statistics (2024)</h2>
        <div class="stats-grid">
          <div class="stat-item"><div class="stat-number">92%</div><div class="stat-label">Placement Rate</div></div>
          <div class="stat-item"><div class="stat-number">₹7.5 LPA</div><div class="stat-label">Average Package</div></div>
          <div class="stat-item"><div class="stat-number">₹22 LPA</div><div class="stat-label">Highest Package</div></div>
          <div class="stat-item"><div class="stat-number">100+</div><div class="stat-label">Companies Visited</div></div>
        </div></div></section>

      <section class="cta-section"><div class="card"><h2>Ready to Build the World?</h2><p>Join our Civil Engineering program and create infrastructure that stands the test of time.</p><div class="cta-buttons"><a href="/course-registration" class="btn btn-primary btn-lg"><i class="fas fa-edit" aria-hidden="true"></i> Apply Now</a><a href="/contact" class="btn btn-outline btn-lg"><i class="fas fa-phone" aria-hidden="true"></i> Contact Admissions</a></div></div></section>
    </div></main>
</Base>