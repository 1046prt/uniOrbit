---
import Base from "../../layouts/Base.astro";
---
<Base title="Electronics & Communication Engineering" scripts={[]}>
  <section class="page-hero" slot="hero">
    <div class="container">
      <span class="eyebrow">Course</span>
      <h1>Electronics & Communication Engineering</h1>
      <p>Connecting the world through advanced communication and embedded systems</p>
      <div class="hero-actions">
        <a href="/course-registration" class="btn btn-primary btn-lg"><i class="fas fa-edit" aria-hidden="true"></i> Register Now</a>
        <a href="/contact" class="btn btn-outline btn-lg"><i class="fas fa-book" aria-hidden="true"></i> Ask about subjects</a>
      </div>
    </div>
  </section>
  <main class="page-main" id="main">
    <div class="container">
      <section class="course-overview"><div class="card"><h2 class="section-title">Course Overview</h2>
        <div class="overview-grid">
          <div class="overview-item"><i class="fas fa-clock" aria-hidden="true"></i><h3>Duration</h3><p>4 Years (8 Semesters)</p></div>
          <div class="overview-item"><i class="fas fa-graduation-cap" aria-hidden="true"></i><h3>Degree</h3><p>Bachelor of Technology (B.Tech)</p></div>
          <div class="overview-item"><i class="fas fa-users" aria-hidden="true"></i><h3>Intake</h3><p>90 Students per year</p></div>
          <div class="overview-item"><i class="fas fa-star" aria-hidden="true"></i><h3>NAAC Rating</h3><p>A++ Grade</p></div>
        </div></div></section>

      <section class="program-highlights"><div class="card"><h2 class="section-title">Program Highlights</h2>
        <div class="highlights-grid">
          <div class="highlight-item"><div class="highlight-icon"><i class="fas fa-microchip" aria-hidden="true"></i></div><h3>VLSI & Embedded Labs</h3><p>FPGA boards, ASIC design tools, ARM/RTOS kits, RF/microwave test equipment</p></div>
          <div class="highlight-item"><div class="highlight-icon"><i class="fas fa-handshake" aria-hidden="true"></i></div><h3>Industry Partnerships</h3><p>Semiconductor, telecom, IoT, and consumer electronics industry tie-ups</p></div>
          <div class="highlight-item"><div class="highlight-icon"><i class="fas fa-flask" aria-hidden="true"></i></div><h3>Research Focus</h3><p>5G/6G, IoT, VLSI, signal processing, AI at edge, quantum communication</p></div>
          <div class="highlight-item"><div class="highlight-icon"><i class="fas fa-globe" aria-hidden="true"></i></div><h3>Global Exposure</h3><p>IEEE/IEICE chapters, international conferences, semiconductor exchange programs</p></div>
        </div></div></section>

      <section class="curriculum"><div class="card"><h2 class="section-title">Curriculum Structure</h2>
        <div class="semester-grid">
          <div class="semester"><h3>Semester 1 & 2</h3><ul><li>Engineering Mathematics I & II</li><li>Electronic Devices & Circuits</li><li>Digital Logic Design</li><li>Network Theory & Signals</li><li>Programming & Data Structures</li></ul></div>
          <div class="semester"><h3>Semester 3 & 4</h3><ul><li>Analog & Digital Communication</li><li>Microprocessors & Microcontrollers</li><li>Electromagnetic Waves & Antennas</li><li>Control Systems</li><li>VLSI Design Basics</li></ul></div>
          <div class="semester"><h3>Semester 5 & 6</h3><ul><li>Digital Signal Processing</li><li>Wireless & Mobile Communication</li><li>Embedded Systems & RTOS</li><li>Optical Communication</li><li>Computer Networks & IoT</li></ul></div>
          <div class="semester"><h3>Semester 7 & 8</h3><ul><li>Capstone Project I & II</li><li>Professional Electives (4)</li><li>Industry Internship</li><li>Seminar & Technical Writing</li><li>Comprehensive Viva</li></ul></div>
        </div></div></section>

      <section class="career-prospects"><div class="card"><h2 class="section-title">Career Prospects</h2>
        <div class="career-grid">
          <div class="career-item"><h3>VLSI Design Engineer</h3><p>RTL design, verification, synthesis, physical design, tapeout</p><div class="salary-range">₹8-22 LPA</div></div>
          <div class="career-item"><h3>Embedded Systems Engineer</h3><p>Firmware, RTOS, drivers, IoT, automotive, medical devices</p><div class="salary-range">₹7-18 LPA</div></div>
          <div class="career-item"><h3>Communication Engineer</h3><p>5G/6G, RF design, link budget, protocol stacks, optimization</p><div class="salary-range">₹6-18 LPA</div></div>
          <div class="career-item"><h3>Signal Processing Engineer</h3><p>Audio/video processing, computer vision, radar, biomedical signals</p><div class="salary-range">₹7-20 LPA</div></div>
        </div></div></section>

      <section class="placement-stats"><div class="card"><h2 class="section-title">Placement Statistics (2024)</h2>
        <div class="stats-grid">
          <div class="stat-item"><div class="stat-number">95%</div><div class="stat-label">Placement Rate</div></div>
          <div class="stat-item"><div class="stat-number">₹10.5 LPA</div><div class="stat-label">Average Package</div></div>
          <div class="stat-item"><div class="stat-number">₹32 LPA</div><div class="stat-label">Highest Package</div></div>
          <div class="stat-item"><div class="stat-number">100+</div><div class="stat-label">Companies Visited</div></div>
        </div></div></section>

      <section class="cta-section"><div class="card"><h2>Ready to Connect the World?</h2><p>Join our Electronics & Communication Engineering program and build the technology that connects billions.</p><div class="cta-buttons"><a href="/course-registration" class="btn btn-primary btn-lg"><i class="fas fa-edit" aria-hidden="true"></i> Apply Now</a><a href="/contact" class="btn btn-outline btn-lg"><i class="fas fa-phone" aria-hidden="true"></i> Contact Admissions</a></div></div></section>
    </div></main>
</Base>