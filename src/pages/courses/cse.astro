---
import Base from "../../layouts/Base.astro";
---
<Base title="Computer Science Engineering" scripts={[]}>
  <section class="page-hero" slot="hero">
    <div class="container">
      <span class="eyebrow">Course</span>
      <h1>Computer Science Engineering</h1>
      <p>Building the future through innovative technology and software solutions</p>
      <div class="hero-actions">
        <a href="/course-registration" class="btn btn-primary btn-lg">
          <i class="fas fa-edit" aria-hidden="true"></i> Register Now
        </a>
        <a href="/subjects/cse" class="btn btn-outline btn-lg">
          <i class="fas fa-book" aria-hidden="true"></i> View Subjects
        </a>
      </div>
    </div>
  </section>

  <main class="page-main" id="main">
    <div class="container">
      <!-- Course Overview -->
      <section class="course-overview">
        <div class="card">
          <h2 class="section-title">Course Overview</h2>
          <div class="overview-grid">
            <div class="overview-item">
              <i class="fas fa-clock" aria-hidden="true"></i>
              <h3>Duration</h3>
              <p>4 Years (8 Semesters)</p>
            </div>
            <div class="overview-item">
              <i class="fas fa-graduation-cap" aria-hidden="true"></i>
              <h3>Degree</h3>
              <p>Bachelor of Technology (B.Tech)</p>
            </div>
            <div class="overview-item">
              <i class="fas fa-users" aria-hidden="true"></i>
              <h3>Intake</h3>
              <p>120 Students per year</p>
            </div>
            <div class="overview-item">
              <i class="fas fa-star" aria-hidden="true"></i>
              <h3>NAAC Rating</h3>
              <p>A++ Grade</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Program Highlights -->
      <section class="program-highlights">
        <div class="card">
          <h2 class="section-title">Program Highlights</h2>
          <div class="highlights-grid">
            <div class="highlight-item">
              <div class="highlight-icon">
                <i class="fas fa-laptop-code" aria-hidden="true"></i>
              </div>
              <h3>Modern Curriculum</h3>
              <p>
                Updated curriculum covering latest technologies including AI,
                Machine Learning, Cloud Computing, and Cybersecurity
              </p>
            </div>
            <div class="highlight-item">
              <div class="highlight-icon">
                <i class="fas fa-handshake" aria-hidden="true"></i>
              </div>
              <h3>Industry Partnerships</h3>
              <p>
                Strong collaborations with leading tech companies for
                internships, projects, and placements
              </p>
            </div>
            <div class="highlight-item">
              <div class="highlight-icon">
                <i class="fas fa-flask" aria-hidden="true"></i>
              </div>
              <h3>Research Focus</h3>
              <p>
                Opportunities to work on cutting-edge research projects and
                publish papers
              </p>
            </div>
            <div class="highlight-item">
              <div class="highlight-icon">
                <i class="fas fa-globe" aria-hidden="true"></i>
              </div>
              <h3>Global Exposure</h3>
              <p>
                International exchange programs and collaborations with
                universities worldwide
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Curriculum Structure -->
      <section class="curriculum">
        <div class="card">
          <h2 class="section-title">Curriculum Structure</h2>
          <div class="semester-grid">
            <div class="semester">
              <h3>Semester 1 & 2</h3>
              <ul>
                <li>Engineering Mathematics</li>
                <li>Programming Fundamentals</li>
                <li>Digital Logic Design</li>
                <li>Computer Organization</li>
                <li>Data Structures</li>
              </ul>
            </div>
            <div class="semester">
              <h3>Semester 3 & 4</h3>
              <ul>
                <li>Object-Oriented Programming</li>
                <li>Database Management Systems</li>
                <li>Computer Networks</li>
                <li>Operating Systems</li>
                <li>Software Engineering</li>
              </ul>
            </div>
            <div class="semester">
              <h3>Semester 5 & 6</h3>
              <ul>
                <li>Web Technologies</li>
                <li>Mobile Application Development</li>
                <li>Cloud Computing</li>
                <li>Cybersecurity</li>
                <li>Machine Learning</li>
              </ul>
            </div>
            <div class="semester">
              <h3>Semester 7 & 8</h3>
              <ul>
                <li>Artificial Intelligence</li>
                <li>Big Data Analytics</li>
                <li>Internet of Things</li>
                <li>Capstone Project</li>
                <li>Internship</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Career Prospects -->
      <section class="career-prospects">
        <div class="card">
          <h2 class="section-title">Career Prospects</h2>
          <div class="career-grid">
            <div class="career-item">
              <h3>Software Development</h3>
              <p>Full-stack developer, Mobile app developer, Game developer</p>
              <div class="salary-range">₹6-15 LPA</div>
            </div>
            <div class="career-item">
              <h3>Data Science</h3>
              <p>Data analyst, Data scientist, Business intelligence analyst</p>
              <div class="salary-range">₹8-20 LPA</div>
            </div>
            <div class="career-item">
              <h3>Cybersecurity</h3>
              <p>Security analyst, Penetration tester, Security architect</p>
              <div class="salary-range">₹7-18 LPA</div>
            </div>
            <div class="career-item">
              <h3>Cloud Computing</h3>
              <p>Cloud engineer, DevOps engineer, Solutions architect</p>
              <div class="salary-range">₹8-22 LPA</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Placement Statistics -->
      <section class="placement-stats">
        <div class="card">
          <h2 class="section-title">Placement Statistics (2024)</h2>
          <div class="stats-grid">
            <div class="stat-item">
              <div class="stat-number">95%</div>
              <div class="stat-label">Placement Rate</div>
            </div>
            <div class="stat-item">
              <div class="stat-number">₹12.5 LPA</div>
              <div class="stat-label">Average Package</div>
            </div>
            <div class="stat-item">
              <div class="stat-number">₹45 LPA</div>
              <div class="stat-label">Highest Package</div>
            </div>
            <div class="stat-item">
              <div class="stat-number">150+</div>
              <div class="stat-label">Companies Visited</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Call to Action -->
      <section class="cta-section">
        <div class="card">
          <h2>Ready to Start Your Journey?</h2>
          <p>
            Join our Computer Science Engineering program and become part of
            the next generation of tech innovators.
          </p>
          <div class="cta-buttons">
            <a
              href="/course-registration"
              class="btn btn-primary btn-lg"
            >
              <i class="fas fa-edit" aria-hidden="true"></i> Apply Now
            </a>
            <a href="/contact" class="btn btn-outline btn-lg">
              <i class="fas fa-phone" aria-hidden="true"></i> Contact Admissions
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>
</Base>