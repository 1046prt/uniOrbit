---
import Base from "../../layouts/Base.astro";
---
<Base title="Data Science & AI Engineering" scripts={[]}>
  <section class="page-hero" slot="hero">
    <div class="container">
      <span class="eyebrow">Course</span>
      <h1>Data Science & AI Engineering</h1>
      <p>Pioneering the future of intelligent systems and data-driven innovation</p>
      <div class="hero-actions">
        <a href="/course-registration" class="btn btn-primary btn-lg"><i class="fas fa-edit" aria-hidden="true"></i> Register Now</a>
        <a href="/subjects/ds-ai" class="btn btn-outline btn-lg"><i class="fas fa-book" aria-hidden="true"></i> View Subjects</a>
      </div>
    </div>
  </section>
  <main class="page-main" id="main">
    <div class="container">
      <section class="course-overview"><div class="card"><h2 class="section-title">Course Overview</h2>
        <div class="overview-grid">
          <div class="overview-item"><i class="fas fa-clock" aria-hidden="true"></i><h3>Duration</h3><p>4 Years (8 Semesters)</p></div>
          <div class="overview-item"><i class="fas fa-graduation-cap" aria-hidden="true"></i><h3>Degree</h3><p>Bachelor of Technology (B.Tech)</p></div>
          <div class="overview-item"><i class="fas fa-users" aria-hidden="true"></i><h3>Intake</h3><p>60 Students per year</p></div>
          <div class="overview-item"><i class="fas fa-star" aria-hidden="true"></i><h3>NAAC Rating</h3><p>A++ Grade</p></div>
        </div></div></section>

      <section class="program-highlights"><div class="card"><h2 class="section-title">Program Highlights</h2>
        <div class="highlights-grid">
          <div class="highlight-item"><div class="highlight-icon"><i class="fas fa-brain" aria-hidden="true"></i></div><h3>AI-First Curriculum</h3><p>Designed from ground up for ML, DL, NLP, Computer Vision, and Generative AI</p></div>
          <div class="highlight-item"><div class="highlight-icon"><i class="fas fa-laptop-code" aria-hidden="true"></i></div><h3>Industry Partnerships</h3><p>Collaborations with leading AI companies for internships, capstones, and research</p></div>
          <div class="highlight-item"><div class="highlight-icon"><i class="fas fa-flask" aria-hidden="true"></i></div><h3>Research Focus</h3><p>Dedicated AI labs, GPU clusters, publication support, conference travel grants</p></div>
          <div class="highlight-item"><div class="highlight-icon"><i class="fas fa-globe" aria-hidden="true"></i></div><h3>Global Exposure</h3><p>Exchange programs with top universities, international hackathons, joint research</p></div>
        </div></div></section>

      <section class="curriculum"><div class="card"><h2 class="section-title">Curriculum Structure</h2>
        <div class="semester-grid">
          <div class="semester"><h3>Semester 1 & 2</h3><ul><li>Engineering Mathematics I & II</li><li>Python Programming & Data Structures</li><li>Statistics & Probability</li><li>Discrete Mathematics</li><li>Physics for Data Science</li></ul></div>
          <div class="semester"><h3>Semester 3 & 4</h3><ul><li>Database Systems & OS</li><li>Intro to Machine Learning</li><li>Deep Learning Fundamentals</li><li>Data Visualization</li><li>Software Engineering</li></ul></div>
          <div class="semester"><h3>Semester 5 & 6</h3><ul><li>NLP & Computer Vision</li><li>Reinforcement Learning</li><li>Big Data Analytics</li><li>MLOps & Generative AI</li><li>Cloud Computing for AI</li></ul></div>
          <div class="semester"><h3>Semester 7 & 8</h3><ul><li>AI Ethics & Security</li><li>Capstone Project I & II</li><li>Industry Internship</li><li>Professional Electives</li><li>Research Seminar</li></ul></div>
        </div></div></section>

      <section class="career-prospects"><div class="card"><h2 class="section-title">Career Prospects</h2>
        <div class="career-grid">
          <div class="career-item"><h3>Machine Learning Engineer</h3><p>Model development, training pipelines, production deployment</p><div class="salary-range">₹12-30 LPA</div></div>
          <div class="career-item"><h3>Data Scientist</h3><p>Analytics, statistical modeling, business insights, A/B testing</p><div class="salary-range">₹10-25 LPA</div></div>
          <div class="career-item"><h3>AI Research Scientist</h3><p>Novel algorithms, publications, advancing state-of-the-art</p><div class="salary-range">₹15-40 LPA</div></div>
          <div class="career-item"><h3>MLOps Engineer</h3><p>Model serving, monitoring, CI/CD, feature stores, scaling</p><div class="salary-range">₹12-28 LPA</div></div>
        </div></div></section>

      <section class="placement-stats"><div class="card"><h2 class="section-title">Placement Statistics (2024)</h2>
        <div class="stats-grid">
          <div class="stat-item"><div class="stat-number">98%</div><div class="stat-label">Placement Rate</div></div>
          <div class="stat-item"><div class="stat-number">₹18.5 LPA</div><div class="stat-label">Average Package</div></div>
          <div class="stat-item"><div class="stat-number">₹52 LPA</div><div class="stat-label">Highest Package</div></div>
          <div class="stat-item"><div class="stat-number">120+</div><div class="stat-label">Companies Visited</div></div>
        </div></div></section>

      <section class="cta-section"><div class="card"><h2>Ready to Shape the AI Future?</h2><p>Join our Data Science & AI Engineering program and become part of the next generation of AI innovators.</p><div class="cta-buttons"><a href="/course-registration" class="btn btn-primary btn-lg"><i class="fas fa-edit" aria-hidden="true"></i> Apply Now</a><a href="/contact" class="btn btn-outline btn-lg"><i class="fas fa-phone" aria-hidden="true"></i> Contact Admissions</a></div></div></section>
    </div></main>
</Base>