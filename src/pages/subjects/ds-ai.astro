---
import Base from "../../layouts/Base.astro";
---
<Base title="Data Science & AI Engineering Subjects" scripts={[]}>
  <section class="page-hero" slot="hero">
    <div class="container">
      <span class="eyebrow">Subjects</span>
      <h1>Data Science & AI Engineering Subjects</h1>
      <p>Cutting-edge curriculum covering data science, machine learning and artificial intelligence</p>
      <div class="hero-actions">
        <a href="/course-registration" class="btn btn-primary btn-lg">
          <i class="fas fa-edit" aria-hidden="true"></i> Register Now
        </a>
        <a href="/courses/dsai" class="btn btn-outline btn-lg">
          <i class="fas fa-graduation-cap" aria-hidden="true"></i> View Course
        </a>
      </div>
    </div>
  </section>

  <main class="page-main" id="main">
    <div class="container">
      <section class="subject-overview">
        <div class="card">
          <h2 class="section-title">Subject Overview</h2>
          <p class="overview-text">
            Our Data Science & AI Engineering program offers a comprehensive
            curriculum designed to prepare students for the rapidly evolving
            field of data science and artificial intelligence. The subjects are
            carefully structured to provide both theoretical knowledge and
            practical skills in machine learning, deep learning, data analysis,
            and AI applications.
          </p>
          <div class="overview-stats">
            <div class="stat-item">
              <div class="stat-number">35+</div>
              <div class="stat-label">Core Subjects</div>
            </div>
            <div class="stat-item">
              <div class="stat-number">12+</div>
              <div class="stat-label">Elective Subjects</div>
            </div>
            <div class="stat-item">
              <div class="stat-number">8</div>
              <div class="stat-label">Semesters</div>
            </div>
            <div class="stat-item">
              <div class="stat-number">180</div>
              <div class="stat-label">Total Credits</div>
            </div>
          </div>
        </div>
      </section>

      <section class="semester-subjects">
        <div class="card">
          <h2 class="section-title">Semester-wise Subject Distribution</h2>

          <div class="semester-section">
            <h3 class="semester-title">Semester 1</h3>
            <div class="subjects-grid">
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-calculator" aria-hidden="true"></i>
                  <h4>Engineering Mathematics I</h4>
                </div>
                <p>Calculus, Linear Algebra, Differential Equations</p>
                <div class="subject-details">
                  <span class="credits">4 Credits</span>
                  <span class="type core">Core</span>
                </div>
              </div>
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-code" aria-hidden="true"></i>
                  <h4>Programming Fundamentals</h4>
                </div>
                <p>Python Programming, Data Types, Control Structures</p>
                <div class="subject-details">
                  <span class="credits">3 Credits</span>
                  <span class="type core">Core</span>
                </div>
              </div>
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-chart-bar" aria-hidden="true"></i>
                  <h4>Statistics & Probability</h4>
                </div>
                <p>Descriptive Statistics, Probability Distributions, Hypothesis Testing</p>
                <div class="subject-details">
                  <span class="credits">3 Credits</span>
                  <span class="type core">Core</span>
                </div>
              </div>
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-atom" aria-hidden="true"></i>
                  <h4>Physics for Data Science</h4>
                </div>
                <p>Mechanics, Waves, Optics, Computational Physics</p>
                <div class="subject-details">
                  <span class="credits">3 Credits</span>
                  <span class="type core">Core</span>
                </div>
              </div>
            </div>
          </div>

          <div class="semester-section">
            <h3 class="semester-title">Semester 2</h3>
            <div class="subjects-grid">
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-calculator" aria-hidden="true"></i>
                  <h4>Engineering Mathematics II</h4>
                </div>
                <p>Multivariable Calculus, Linear Algebra, Optimization</p>
                <div class="subject-details">
                  <span class="credits">4 Credits</span>
                  <span class="type core">Core</span>
                </div>
              </div>
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-database" aria-hidden="true"></i>
                  <h4>Data Structures & Algorithms</h4>
                </div>
                <p>Arrays, Lists, Trees, Graphs, Sorting, Searching</p>
                <div class="subject-details">
                  <span class="credits">4 Credits</span>
                  <span class="type core">Core</span>
                </div>
              </div>
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-chart-line" aria-hidden="true"></i>
                  <h4>Statistical Inference</h4>
                </div>
                <p>Estimation, Confidence Intervals, Regression Analysis</p>
                <div class="subject-details">
                  <span class="credits">3 Credits</span>
                  <span class="type core">Core</span>
                </div>
              </div>
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-cogs" aria-hidden="true"></i>
                  <h4>Discrete Mathematics</h4>
                </div>
                <p>Logic, Sets, Relations, Graph Theory, Combinatorics</p>
                <div class="subject-details">
                  <span class="credits">3 Credits</span>
                  <span class="type core">Core</span>
                </div>
              </div>
            </div>
          </div>

          <div class="semester-section">
            <h3 class="semester-title">Semester 3</h3>
            <div class="subjects-grid">
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-database" aria-hidden="true"></i>
                  <h4>Database Management Systems</h4>
                </div>
                <p>SQL, NoSQL, Data Modeling, Transaction Management</p>
                <div class="subject-details">
                  <span class="credits">3 Credits</span>
                  <span class="type core">Core</span>
                </div>
              </div>
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-desktop" aria-hidden="true"></i>
                  <h4>Operating Systems</h4>
                </div>
                <p>Process Management, Memory, File Systems, Concurrency</p>
                <div class="subject-details">
                  <span class="credits">3 Credits</span>
                  <span class="type core">Core</span>
                </div>
              </div>
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-network-wired" aria-hidden="true"></i>
                  <h4>Computer Networks</h4>
                </div>
                <p>OSI/TCP-IP, Protocols, Network Security, Distributed Systems</p>
                <div class="subject-details">
                  <span class="credits">3 Credits</span>
                  <span class="type core">Core</span>
                </div>
              </div>
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-brain" aria-hidden="true"></i>
                  <h4>Introduction to Machine Learning</h4>
                </div>
                <p>Supervised Learning, Linear/Logistic Regression, Decision Trees</p>
                <div class="subject-details">
                  <span class="credits">4 Credits</span>
                  <span class="type core">Core</span>
                </div>
              </div>
            </div>
          </div>

          <div class="semester-section">
            <h3 class="semester-title">Semester 4</h3>
            <div class="subjects-grid">
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-cogs" aria-hidden="true"></i>
                  <h4>Software Engineering</h4>
                </div>
                <p>SDLC, Agile, Testing, DevOps, CI/CD Pipelines</p>
                <div class="subject-details">
                  <span class="credits">3 Credits</span>
                  <span class="type core">Core</span>
                </div>
              </div>
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-search" aria-hidden="true"></i>
                  <h4>Design & Analysis of Algorithms</h4>
                </div>
                <p>Complexity, Dynamic Programming, Greedy, Graph Algorithms</p>
                <div class="subject-details">
                  <span class="credits">4 Credits</span>
                  <span class="type core">Core</span>
                </div>
              </div>
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-brain" aria-hidden="true"></i>
                  <h4>Deep Learning Fundamentals</h4>
                </div>
                <p>Neural Networks, Backpropagation, CNNs, RNNs, Transformers</p>
                <div class="subject-details">
                  <span class="credits">4 Credits</span>
                  <span class="type core">Core</span>
                </div>
              </div>
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-chart-area" aria-hidden="true"></i>
                  <h4>Data Visualization</h4>
                </div>
                <p>Visualization Principles, D3.js, Tableau, Dashboard Design</p>
                <div class="subject-details">
                  <span class="credits">3 Credits</span>
                  <span class="type core">Core</span>
                </div>
              </div>
            </div>
          </div>

          <div class="semester-section">
            <h3 class="semester-title">Semester 5</h3>
            <div class="subjects-grid">
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-cloud" aria-hidden="true"></i>
                  <h4>Cloud Computing for AI</h4>
                </div>
                <p>AWS/Azure/GCP, ML Services, MLOps, Serverless AI</p>
                <div class="subject-details">
                  <span class="credits">3 Credits</span>
                  <span class="type core">Core</span>
                </div>
              </div>
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-shield-alt" aria-hidden="true"></i>
                  <h4>AI Ethics & Security</h4>
                </div>
                <p>Bias, Fairness, Privacy, Adversarial Attacks, Governance</p>
                <div class="subject-details">
                  <span class="credits">3 Credits</span>
                  <span class="type core">Core</span>
                </div>
              </div>
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-language" aria-hidden="true"></i>
                  <h4>Natural Language Processing</h4>
                </div>
                <p>Text Processing, Embeddings, Transformers, LLMs</p>
                <div class="subject-details">
                  <span class="credits">4 Credits</span>
                  <span class="type core">Core</span>
                </div>
              </div>
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-eye" aria-hidden="true"></i>
                  <h4>Computer Vision</h4>
                </div>
                <p>Image Processing, CNNs, Object Detection, Segmentation</p>
                <div class="subject-details">
                  <span class="credits">3 Credits</span>
                  <span class="type core">Core</span>
                </div>
              </div>
            </div>
          </div>

          <div class="semester-section">
            <h3 class="semester-title">Semester 6</h3>
            <div class="subjects-grid">
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-robot" aria-hidden="true"></i>
                  <h4>Reinforcement Learning</h4>
                </div>
                <p>MDPs, Q-Learning, Policy Gradients, Actor-Critic Methods</p>
                <div class="subject-details">
                  <span class="credits">4 Credits</span>
                  <span class="type core">Core</span>
                </div>
              </div>
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-chart-bar" aria-hidden="true"></i>
                  <h4>Big Data Analytics</h4>
                </div>
                <p>Hadoop, Spark, Kafka, Real-time Processing, Data Lakes</p>
                <div class="subject-details">
                  <span class="credits">3 Credits</span>
                  <span class="type core">Core</span>
                </div>
              </div>
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-wifi" aria-hidden="true"></i>
                  <h4>MLOps & Model Deployment</h4>
                </div>
                <p>Model Serving, Monitoring, A/B Testing, Feature Stores</p>
                <div class="subject-details">
                  <span class="credits">3 Credits</span>
                  <span class="type core">Core</span>
                </div>
              </div>
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-cube" aria-hidden="true"></i>
                  <h4>Generative AI</h4>
                </div>
                <p>GANs, VAEs, Diffusion Models, Prompt Engineering</p>
                <div class="subject-details">
                  <span class="credits">3 Credits</span>
                  <span class="type core">Core</span>
                </div>
              </div>
            </div>
          </div>

          <div class="semester-section">
            <h3 class="semester-title">Semester 7</h3>
            <div class="subjects-grid">
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-laptop-code" aria-hidden="true"></i>
                  <h4>Capstone Project I</h4>
                </div>
                <p>Problem Definition, Data Collection, Literature Review</p>
                <div class="subject-details">
                  <span class="credits">6 Credits</span>
                  <span class="type project">Project</span>
                </div>
              </div>
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-graduation-cap" aria-hidden="true"></i>
                  <h4>Professional Elective I</h4>
                </div>
                <p>Specialized AI/ML topics</p>
                <div class="subject-details">
                  <span class="credits">3 Credits</span>
                  <span class="type elective">Elective</span>
                </div>
              </div>
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-graduation-cap" aria-hidden="true"></i>
                  <h4>Professional Elective II</h4>
                </div>
                <p>Specialized AI/ML topics</p>
                <div class="subject-details">
                  <span class="credits">3 Credits</span>
                  <span class="type elective">Elective</span>
                </div>
              </div>
            </div>
          </div>

          <div class="semester-section">
            <h3 class="semester-title">Semester 8</h3>
            <div class="subjects-grid">
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-laptop-code" aria-hidden="true"></i>
                  <h4>Capstone Project II</h4>
                </div>
                <p>Model Development, Evaluation, Deployment, Documentation</p>
                <div class="subject-details">
                  <span class="credits">6 Credits</span>
                  <span class="type project">Project</span>
                </div>
              </div>
              <div class="subject-card">
                <div class="subject-header">
                  <i class="fas fa-briefcase" aria-hidden="true"></i>
                  <h4>Industry Internship</h4>
                </div>
                <p>Real-world AI/ML experience in industry</p>
                <div class="subject-details">
                  <span class="credits">4 Credits</span>
                  <span class="type internship">Internship</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="elective-subjects">
        <div class="card">
          <h2 class="section-title">Professional Elective Subjects</h2>
          <p class="section-description">
            Students can choose from the following elective subjects based on
            their interests and career goals:
          </p>

          <div class="elective-categories">
            <div class="elective-category">
              <h3>Advanced Machine Learning</h3>
              <ul class="elective-subjects">
                <li>Advanced Deep Learning Architectures</li>
                <li>Meta Learning & Few-Shot Learning</li>
                <li>Automated Machine Learning (AutoML)</li>
                <li>Federated Learning</li>
              </ul>
            </div>
            <div class="elective-category">
              <h3>Specialized AI Applications</h3>
              <ul class="elective-subjects">
                <li>AI in Healthcare & Medical Imaging</li>
                <li>AI for Finance & Algorithmic Trading</li>
                <li>AI in Robotics & Autonomous Systems</li>
                <li>AI for Climate & Sustainability</li>
              </ul>
            </div>
            <div class="elective-category">
              <h3>Data Engineering</h3>
              <ul class="elective-subjects">
                <li>Data Pipeline Architecture</li>
                <li>Real-time Stream Processing</li>
                <li>Feature Engineering at Scale</li>
                <li>Data Quality & Governance</li>
              </ul>
            </div>
            <div class="elective-category">
              <h3>Emerging AI Frontiers</h3>
              <ul class="elective-subjects">
                <li>Quantum Machine Learning</li>
                <li>Neurosymbolic AI</li>
                <li>Constitutional AI & Alignment</li>
                <li>AI Agents & Multi-Agent Systems</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section class="cta-section">
        <div class="card">
          <h2>Ready to Start Your DS & AI Journey?</h2>
          <p>
            Explore our cutting-edge curriculum and begin your path to
            becoming a successful AI engineer or data scientist.
          </p>
          <div class="cta-buttons">
            <a
              href="/course-registration"
              class="btn btn-primary btn-lg"
            >
              <i class="fas fa-edit" aria-hidden="true"></i> Apply Now
            </a>
            <a href="/contact" class="btn btn-outline btn-lg">
              <i class="fas fa-phone" aria-hidden="true"></i> Contact Department
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>
</Base>