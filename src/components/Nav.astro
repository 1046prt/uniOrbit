---
import Logo from "./Logo.astro";

const path = Astro.url.pathname;
const active = (p) => (p === "/" ? path === "/" : path.startsWith(p));

const courses = [
  ["Computer Science", "cse"],
  ["Data Science & AI", "dsai"],
  ["Civil", "civil"],
  ["Mechanical", "mechanical"],
  ["Electrical", "electrical"],
  ["Electronics & Comm.", "electronics"],
];

const subjects = [
  ["CSE", "cse"],
  ["DS & AI", "ds-ai"],
  ["Civil", "civil"],
  ["Mechanical", "mechanical"],
  ["Electrical", "electrical"],
];
---
<header class="site-nav">
  <nav class="nav-pill" aria-label="Main navigation">
    <a href="/" class="nav-brand" aria-label="UniOrbit home">
      <Logo size={34} />
    </a>

    <button
      class="nav-toggle"
      id="nav-toggle"
      type="button"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <i class="fas fa-bars" aria-hidden="true"></i>
    </button>

    <ul class="nav-links" id="nav-menu">
      <li><a href="/" class:list={[{ on: active("/") }]}>Home</a></li>

      <li class="has-menu">
        <a
          href="/courses/cse"
          aria-haspopup="true"
          aria-expanded="false"
          class:list={[{ on: active("/courses") }]}
          data-menu
        >
          Courses <i class="fas fa-chevron-down" aria-hidden="true"></i>
        </a>
        <ul class="menu">
          {
            courses.map(([name, slug]) => (
              <li><a href={`/courses/${slug}`}>{name}</a></li>
            ))
          }
        </ul>
      </li>

      <li class="has-menu">
        <a
          href="/subjects/cse"
          aria-haspopup="true"
          aria-expanded="false"
          class:list={[{ on: active("/subjects") }]}
          data-menu
        >
          Subjects <i class="fas fa-chevron-down" aria-hidden="true"></i>
        </a>
        <ul class="menu">
          {
            subjects.map(([name, slug]) => (
              <li><a href={`/subjects/${slug}`}>{name}</a></li>
            ))
          }
        </ul>
      </li>

      <li><a href="/fees/fee-structure" class:list={[{ on: active("/fees") }]}>Fees</a></li>
      <li><a href="/academic-calendar" class:list={[{ on: active("/academic-calendar") }]}>Calendar</a></li>
      <li><a href="/contact" class:list={[{ on: active("/contact") }]}>Contact</a></li>

      <li class="nav-mobile-only"><a href="/login">Login</a></li>
      <li class="nav-mobile-only"><a href="/register">Join UniOrbit</a></li>
    </ul>

    <div class="nav-actions">
      <button id="theme-toggle" class="icon-btn" aria-label="Switch theme" type="button">
        <i class="fas fa-moon" aria-hidden="true"></i>
      </button>
      <a href="/login" class="btn btn-ghost btn-sm">Login</a>
      <a href="/register" class="btn btn-primary btn-sm">Join</a>
    </div>
  </nav>
</header>
